<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mybank.gui.MonetController">
  <padding>
    <Insets top="12" right="12" bottom="12" left="12"/>
  </padding>
  <HBox spacing="8" alignment="CENTER_LEFT">
    <Label text="Customer"/>
    <ComboBox fx:id="customers" prefWidth="180"/>
    <Button fx:id="showButton" text="Show" onAction="#showCustomer"/>
    <Button text="Report" onAction="#showReport"/>
    <Button text="About" onAction="#showAbout"/>
  </HBox>
  <TextArea fx:id="output" editable="false" VBox.vgrow="ALWAYS"/>
</VBox>
